#!/usr/bin/env python3
"""The codequest command: start, stop and open CodeQuest without keeping a terminal open.

    codequest              start in the background (if needed) and open it in your browser
    codequest phone        show the address (and a QR code) for your phone or tablet
    codequest stop         stop it
    codequest status       is it running? which address? are Godot and Rust found?
    codequest logs         show the server log
    codequest pin 4821     require a PIN (codequest pin off to remove it)
    codequest port 9000    use another port
    codequest godot PATH   tell CodeQuest where Godot is
    codequest autostart on start it automatically when you log in (Linux, systemd)
    codequest run          run in this terminal instead of the background
"""

import json
import os
import shutil
import signal
import subprocess
import sys
import time
import urllib.request
import webbrowser
from pathlib import Path

HERE = Path(__file__).resolve().parent
SERVER = HERE / "server.py"

if os.name == "nt":
    BASE = Path(os.environ.get("APPDATA", Path.home())) / "CodeQuest"
    CONFIG_DIR = STATE_DIR = BASE
else:
    CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "codequest"
    STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "codequest"
CONFIG_FILE = CONFIG_DIR / "config.json"
PID_FILE = STATE_DIR / "server.pid"
LOG_FILE = STATE_DIR / "server.log"
SERVICE_NAME = "codequest.service"
SERVICE_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "systemd" / "user" / SERVICE_NAME


# ----------------------------------------------------------------- config ---

def load_config():
    try:
        return json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")


def server_args(config):
    args = ["--port", str(config.get("port", 8000))]
    if config.get("pin"):
        args += ["--pin", str(config["pin"])]
    if config.get("godot"):
        args += ["--godot", config["godot"]]
    return args


def local_url(config):
    return f"http://localhost:{config.get('port', 8000)}"


# ---------------------------------------------------------------- process ---

def info(config):
    """Return the running server's /api/info, or None if nothing answers."""
    try:
        with urllib.request.urlopen(local_url(config) + "/api/info", timeout=1.5) as res:
            data = json.load(res)
            return data if data.get("app") == "codequest" else None
    except (OSError, ValueError):
        return None


def read_pid():
    try:
        return int(PID_FILE.read_text().strip())
    except (OSError, ValueError):
        return None


def service_active():
    if not shutil.which("systemctl"):
        return False
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", SERVICE_NAME],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def systemd_user_available():
    if not shutil.which("systemctl"):
        return False
    return subprocess.run(["systemctl", "--user", "show-environment"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def start(config, quiet=False):
    """Start the server in the background. Returns its info, or None if it didn't come up."""
    running = info(config)
    if running:
        return running
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = open(LOG_FILE, "a", encoding="utf-8")
    log.write(f"\n--- started {time.strftime('%Y-%m-%d %H:%M:%S')} ---\n")
    log.flush()
    kwargs = {"stdout": log, "stderr": subprocess.STDOUT, "stdin": subprocess.DEVNULL, "cwd": HERE}
    if os.name == "nt":
        kwargs["creationflags"] = 0x00000008 | 0x00000200  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    else:
        kwargs["start_new_session"] = True
    proc = subprocess.Popen([sys.executable, "-u", str(SERVER)] + server_args(config), **kwargs)
    PID_FILE.write_text(str(proc.pid))
    if not quiet:
        print("Starting CodeQuest", end="", flush=True)
    for _ in range(40):
        time.sleep(0.25)
        running = info(config)
        if running:
            if not quiet:
                print(" ready.")
            return running
        if proc.poll() is not None:
            break
        if not quiet:
            print(".", end="", flush=True)
    if sys.stdout is None and os.name == "nt":
        os.startfile(LOG_FILE)  # started from a shortcut with no console: show the log instead
        return None
    print(f"\nCodeQuest didn't start. The last lines of {LOG_FILE}:\n")
    print("\n".join(LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()[-12:]))
    return None


def stop(config):
    if service_active():
        subprocess.run(["systemctl", "--user", "stop", SERVICE_NAME])
        print("Stopped. (Autostart is still on; it starts again at your next login. Use: codequest autostart off)")
        return
    pid = read_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except (OSError, ProcessLookupError):
            pid = None
        PID_FILE.unlink(missing_ok=True)
    for _ in range(20):
        if not info(config):
            break
        time.sleep(0.2)
    if info(config):
        print(f"Something is still answering at {local_url(config)}. If you started it in a terminal, press Ctrl+C there.")
    else:
        print("Stopped." if pid else "CodeQuest wasn't running.")


# --------------------------------------------------------------- commands ---

def print_addresses(config, data):
    print(f"\n  On this computer:  {local_url(config)}")
    for url in data.get("urls", []):
        print(f"  Phone or tablet:   {url}   (same Wi-Fi)")
    if data.get("pin_required"):
        print("  A PIN is required to run code.")
    print()


def cmd_open(config):
    data = start(config)
    if data:
        webbrowser.open(local_url(config))
        print_addresses(config, data)
        print("  Stop it any time with: codequest stop\n")


def cmd_phone(config):
    data = start(config)
    if not data:
        return
    urls = data.get("urls", [])
    if not urls:
        print("No network address found. Is this computer connected to Wi-Fi or a network cable?")
        return
    print(f"\n  Open this on your phone or tablet (same Wi-Fi):\n\n      {urls[0]}\n")
    if shutil.which("qrencode"):
        subprocess.run(["qrencode", "-t", "ansiutf8", "-m", "2", urls[0]])
    else:
        print("  Tip: install qrencode to get a QR code right here, or use the")
        print("  'Open on phone' button on the CodeQuest home page.")
    print("\n  On the phone, use 'Add to Home Screen' to get a CodeQuest app icon.\n")


def cmd_status(config):
    data = info(config)
    if not data:
        print("CodeQuest is not running. Start it with: codequest")
        return
    how = "autostart service" if service_active() else ("background" if read_pid() else "a terminal")
    print(f"CodeQuest is running ({how}).")
    print_addresses(config, data)
    print(f"  GDScript lessons: {'ready' if data.get('godot') else 'Godot not found (codequest godot /path/to/godot)'}")
    print(f"  Rust lessons:     {'ready' if data.get('rust') else 'Rust not found (install from rustup.rs)'}\n")


def restart_if_running(config, old_config):
    if info(old_config):
        if service_active():
            write_service(config)
            subprocess.run(["systemctl", "--user", "restart", SERVICE_NAME])
            print("Restarted the autostart service with the new setting.")
        else:
            stop(old_config)
            start(config)


def cmd_setting(config, key, value):
    old = dict(config)
    if key == "pin":
        if value in (None, "off", ""):
            config.pop("pin", None)
            print("PIN removed.")
        else:
            config["pin"] = value
            print(f"PIN set to {value}.")
    elif key == "port":
        if not value or not value.isdigit():
            print("Usage: codequest port 9000")
            return
        config["port"] = int(value)
        print(f"Port set to {value}.")
    elif key == "godot":
        if not value or not Path(value).expanduser().exists():
            print("Usage: codequest godot /path/to/godot  (that file has to exist)")
            return
        config["godot"] = str(Path(value).expanduser().resolve())
        print(f"Godot set to {config['godot']}.")
    save_config(config)
    restart_if_running(config, old)


def write_service(config):
    SERVICE_FILE.parent.mkdir(parents=True, exist_ok=True)
    exec_line = " ".join([f'"{sys.executable}"', f'"{SERVER}"'] + [f'"{a}"' for a in server_args(config)])
    SERVICE_FILE.write_text(f"""[Unit]
Description=CodeQuest coding course

[Service]
ExecStart={exec_line}
WorkingDirectory={HERE}
Restart=on-failure

[Install]
WantedBy=default.target
""")


def autostart_fallback():
    print("Your system doesn't have a systemd user session, so autostart can't be set up from here.")
    print("On Hyprland you can add this to hyprland.lua instead:\n")
    print(f'    hl.on("hyprland.start", function() hl.exec_cmd("{HERE / "codequest"} start") end)\n')


def cmd_autostart(config, value):
    if os.name == "nt" and value in ("on", "off"):
        sys.path.insert(0, str(HERE))
        import install_windows  # noqa: E402  (Windows shortcut helpers)
        install_windows.set_autostart(value == "on")
        print(f"Autostart is {value}.")
        return
    if value in ("on", "off") and not systemd_user_available():
        autostart_fallback()
        return
    if value == "on":
        stop_background = read_pid() and info(config)
        if stop_background:
            stop(config)
        write_service(config)
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        if subprocess.run(["systemctl", "--user", "enable", "--now", SERVICE_NAME]).returncode != 0:
            print("Couldn't turn on autostart. See the message above.")
            return
        print("Autostart is on. CodeQuest now runs whenever you're logged in.")
    elif value == "off":
        subprocess.run(["systemctl", "--user", "disable", "--now", SERVICE_NAME])
        SERVICE_FILE.unlink(missing_ok=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        print("Autostart is off.")
    else:
        print("Usage: codequest autostart on|off")


def main():
    config = load_config()
    args = sys.argv[1:]
    command = args[0] if args else "open"
    value = args[1] if len(args) > 1 else None
    if command in ("open", "o"):
        cmd_open(config)
    elif command == "start":
        data = start(config)
        if data:
            print_addresses(config, data)
    elif command == "stop":
        stop(config)
    elif command == "restart":
        stop(config)
        cmd_open(config)
    elif command == "status":
        cmd_status(config)
    elif command == "phone":
        cmd_phone(config)
    elif command == "logs":
        print(LOG_FILE.read_text(encoding="utf-8", errors="replace") if LOG_FILE.exists() else "No log yet.")
    elif command in ("pin", "port", "godot"):
        cmd_setting(config, command, value)
    elif command == "autostart":
        cmd_autostart(config, value)
    elif command == "run":
        os.execv(sys.executable, [sys.executable, str(SERVER)] + server_args(config) + ["--open"])
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
